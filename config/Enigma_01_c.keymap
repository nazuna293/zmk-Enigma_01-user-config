/*
 * Enigma_01 配布用キーマップ（2.0u 配列 = layout_c、41キー）
 * 共通のビヘイビアは Enigma_01_common.dtsi。ここはレイヤーの並びと同時押しの位置だけ
 *
 * 位置の番号: 上の2キー 0-1 ／ 1段目 2-11 ／ 2段目 12-21 ／ 3段目 22-31 ／ 最下段 32-40
 * 最下段: 32 Shift  33 Win  34 Alt  35 Space  36 BS(2.0u)  37 Enter  38 ←  39 ↓  40 →
 */

#include "Enigma_01_common.dtsi"
#include "Enigma_01_variant.dtsi"

#define POS_SPACE 35
#define POS_BS    36
#define POS_ENTER 37

/ {
    COMBOS_BEGIN

        COMBO(esc, &kp ESC, 0 2, BASE)
        COMBO(q, &kp Q, 2 3, BASE)
        COMBO(minus, &kp MINUS, 9 10, BASE)
        COMBO(caret, &kp CARET, 10 11, BASE)
        COMBO(del, &kp DEL, 19 20, BASE NUM)
        COMBO(at, &kp AT_SIGN, 20 21, BASE)
        COMBO(under, &kp UNDERSCORE, 30 31, BASE)
        COMBO(ime_off, &kp INT_MUHENKAN, 12 POS_SPACE, BASE)
        COMBO(ime_on, &kp INT_HENKAN, 21 POS_ENTER, BASE)
        COMBO(macro, &mo MACRO, POS_BS POS_ENTER, BASE)

        COMBO(num_slash, &kp KP_SLASH, 8 9, NUM)
        COMBO(num_star, &kp KP_ASTERISK, 9 10, NUM)
        COMBO(num_equal, &kp EQUAL, 10 11, NUM)
        COMBO(num_enter, &kp KP_ENTER, POS_ENTER 31, NUM)
    COMBOS_END

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
                         &app_alt ALT 0  &app_win WIN 0
&mt LCTRL TAB  &kp W  &kp E  &kp R  &kp T     &kp Y  &kp U  &kp I       &kp O   &kp P
&kp A          &kp S  &kp D  &kp F  &kp G     &kp H  &kp J  &kp K       &kp L   &colon_semi
&kp Z          &kp X  &kp C  &kp V  &lt SET B &kp N  &kp M  &comma_dot  &kp UP  &mt RSHFT SLASH
&shift_caps LSHFT 0  &kp LGUI  &kp LALT  &lt_kp NUM SPACE  &kp BSPC  &lt_kp SYM ENTER  &kp LEFT  &kp DOWN  &kp RIGHT
            >;
            sensor-bindings = <&enc_scroll SCRL_DOWN SCRL_UP>;
        };

        num {
            display-name = "Num";
            bindings = <
                         &kp LS(LC(TAB))  &kp LC(TAB)
&kp LS(TAB)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp PG_UP      &kp LC(PG_UP)  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MINUS
&kp LC(A)    &kp LC(S)  &kp LC(D)  &kp LC(F)  &kp PG_DN      &kp LC(PG_DN)  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS
&kp LC(Z)    &none      &none      &none      &kp LC(LS(N))  &none          &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp DOT
&trans  &trans  &trans  &trans  &trans  &kp KP_N0  &kp LEFT  &kp DOWN  &kp RIGHT
            >;
            sensor-bindings = <&enc_kp LEFT RIGHT>;
        };

        sym {
            display-name = "Sym";
            bindings = <
                         &kp GRAVE  &kp TILDE
&kp EXCL  &kp DQT  &kp HASH  &kp DLLR  &kp PRCNT  &kp AMPS  &kp SQT    &kp LPAR  &kp RPAR  &kp INT_YEN
&kp F1    &kp F2   &kp F3    &kp F4    &kp F5     &kp F6    &kp PLUS   &kp LBKT  &kp RBKT  &kp ASTRK
&kp F7    &kp F8   &kp F9    &kp F10   &kp F11    &kp F12   &kp EQUAL  &kp LT    &kp GT    &kp QMARK
&trans  &trans  &trans  &trans  &trans  &trans  &kp LBRC  &kp RBRC  &kp PIPE
            >;
            sensor-bindings = <&enc_kp C_VOL_DN C_VOL_UP>;
        };

        // 空のレイヤー（ZMK Studio・DYA Studio で自由に割り当てる用。Studio ではレイヤーを足せないため残しておく）
        macro {
            display-name = "Macro";
            bindings = <
                         &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        set {
            display-name = "Set";
            bindings = <
                         &bt BT_CLR  &bt BT_CLR_ALL
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_SEL 3  &bt BT_SEL 4  &none  &none  &kp PSCRN  &kp SLCK  &kp PAUSE_BREAK
&jis_on       &jis_off      &studio_unlock  &none         &none         &none  &none  &kp INS    &kp HOME  &kp PG_UP
&none         &none         &none           &none         &trans        &none  &none  &kp DEL    &kp END   &kp PG_DN
&bootloader  &sys_reset  &none  &none  &none  &none  &none  &none  &none
            >;
        };

        // 左上を押している間。右上で Alt+Tab
        alt {
            display-name = "Alt";
            bindings = <
                         &trans  &kp LA(TAB)
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        // 右上を押している間。左上で Win+Tab
        win {
            display-name = "Win";
            bindings = <
                         &kp LG(TAB)  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
