/*
 * Enigma_01 配布用キーマップ（1.0u 配列 = layout_a、42キー）
 * 共通のビヘイビアは Enigma_01_common.dtsi。ここはレイヤーの並びと同時押しの位置だけ
 *
 * 位置の番号: 上の2キー 0-1 ／ 1段目 2-11 ／ 2段目 12-21 ／ 3段目 22-31 ／ 最下段 32-41
 * 最下段: 32 Shift  33 Win  34 Alt  35 Space  36 BS  37 Delete  38 Enter  39 ←  40 ↓  41 →
 */

#include "Enigma_01_common.dtsi"

#define POS_SPACE 35
#define POS_BS    36
#define POS_ENTER 38

/ {
    combos {
        compatible = "zmk,combos";

        esc     { bindings = <&kp ESC>;          key-positions = <0 2>;              layers = <BASE>; };
        q       { bindings = <&kp Q>;            key-positions = <2 3>;              layers = <BASE>; };
        minus   { bindings = <&kp MINUS>;        key-positions = <9 10>;             layers = <BASE>; };
        caret   { bindings = <&kp CARET>;        key-positions = <10 11>;            layers = <BASE>; };
        del     { bindings = <&kp DEL>;          key-positions = <19 20>;            layers = <BASE NUM>; };
        at      { bindings = <&kp AT_SIGN>;      key-positions = <20 21>;            layers = <BASE>; };
        under   { bindings = <&kp UNDERSCORE>;   key-positions = <30 31>;            layers = <BASE>; };
        ime_off { bindings = <&kp INT_MUHENKAN>; key-positions = <12 POS_SPACE>;     layers = <BASE>; };
        ime_on  { bindings = <&kp INT_HENKAN>;   key-positions = <21 POS_ENTER>;     layers = <BASE>; };
        macro   { bindings = <&mo MACRO>;        key-positions = <POS_BS POS_ENTER>; layers = <BASE>; };

        num_slash { bindings = <&kp KP_SLASH>;    key-positions = <8 9>;           layers = <NUM>; };
        num_star  { bindings = <&kp KP_ASTERISK>; key-positions = <9 10>;          layers = <NUM>; };
        num_equal { bindings = <&kp EQUAL>;       key-positions = <10 11>;         layers = <NUM>; };
        num_enter { bindings = <&kp KP_ENTER>;    key-positions = <POS_ENTER 31>;  layers = <NUM>; };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
                         &app_alt ALT 0  &app_win WIN 0
&mt LCTRL TAB  &kp W  &kp E  &kp R  &kp T     &kp Y  &kp U  &kp I       &kp O   &kp P
&kp A          &kp S  &kp D  &kp F  &kp G     &kp H  &kp J  &kp K       &kp L   &colon_semi
&kp Z          &kp X  &kp C  &kp V  &lt SET B &kp N  &kp M  &comma_dot  &kp UP  &mt RSHFT SLASH
&shift_caps LSHFT 0  &kp LGUI  &kp LALT  &lt_kp NUM SPACE  &kp BSPC  &kp DEL  &lt_kp SYM ENTER  &kp LEFT  &kp DOWN  &kp RIGHT
            >;
            sensor-bindings = <&enc_scroll SCRL_DOWN SCRL_UP>;
        };

        num {
            display-name = "Num";
            bindings = <
                         &kp LS(LC(TAB))  &kp LC(TAB)
&kp LS(TAB)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp PG_UP      &kp LC(PG_UP)  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MINUS
&kp LC(A)    &kp LC(S)  &kp LC(D)  &kp LC(F)  &kp PG_DN      &kp LC(PG_DN)  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS
&kp LC(Z)    &none      &none      &none      &kp LC(LS(N))  &none          &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp DOT
&trans  &trans  &trans  &trans  &trans  &trans  &kp KP_N0  &kp LEFT  &kp DOWN  &kp RIGHT
            >;
            sensor-bindings = <&enc_kp LEFT RIGHT>;
        };

        sym {
            display-name = "Sym";
            bindings = <
                         &kp GRAVE  &kp TILDE
&kp EXCL  &kp DQT  &kp HASH  &kp DLLR  &kp PRCNT  &kp AMPS  &kp SQT    &kp LPAR  &kp RPAR  &kp INT_YEN
&kp F1    &kp F2   &kp F3    &kp F4    &kp F5     &kp F6    &kp PLUS   &kp LBKT  &kp RBKT  &kp ASTRK
&kp F7    &kp F8   &kp F9    &kp F10   &kp F11    &kp F12   &kp EQUAL  &kp LT    &kp GT    &kp QMARK
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LBRC  &kp RBRC  &kp PIPE
            >;
            sensor-bindings = <&enc_kp C_VOL_DN C_VOL_UP>;
        };

        // 空のレイヤー（ZMK Studio・DYA Studio で自由に割り当てる用。Studio ではレイヤーを足せないため残しておく）
        macro {
            display-name = "Macro";
            bindings = <
                         &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        set {
            display-name = "Set";
            bindings = <
                         &bt BT_CLR  &bt BT_CLR_ALL
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_SEL 3  &bt BT_SEL 4  &none  &none  &kp PSCRN  &kp SLCK  &kp PAUSE_BREAK
&jis_on       &jis_off      &studio_unlock  &none         &none         &none  &none  &kp INS    &kp HOME  &kp PG_UP
&none         &none         &none           &none         &trans        &none  &none  &kp DEL    &kp END   &kp PG_DN
&bootloader  &sys_reset  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };

        // 左上を押している間。右上で Alt+Tab
        alt {
            display-name = "Alt";
            bindings = <
                         &trans  &kp LA(TAB)
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        // 右上を押している間。左上で Win+Tab
        win {
            display-name = "Win";
            bindings = <
                         &kp LG(TAB)  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
